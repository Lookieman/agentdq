# Copy this file to .env and fill in the values you need. Never commit .env.
# Every variable the code reads is listed. An empty value means the default
# in the comment applies.

# Model calls (tools/run_suggestion, run_adjudication, run_remediation, and the
# OpenAI rows of tools/benchmark_embedding_models). No default. The offline
# tests, the dashboard and the gate do not need it.
OPENAI_API_KEY=

# DSPy model name. Default: openai/gpt-4o-mini. A --model flag wins over it.
AGENTDQ_MODEL=

# The variables below are read by the Streamlit apps from the shell
# environment only; the apps do not load .env. Export one only to change its
# default. Do not export it empty: an empty value replaces the default.

# Rules repository backend for app/gate.py and app/bank_browser.py.
# Default: file. Use session for a per-visitor sandbox that saves nothing.
AGENTDQ_REPO_MODE=

# Folder of the file-backed repository. Default: data/repository
AGENTDQ_REPO_DIR=

# Folder that receives the approved-rules export after every state change.
# Default: data/approved
AGENTDQ_APPROVED_DIR=

# Rule bank folder for app/bank_browser.py. Default: config/rule_bank
AGENTDQ_BANK_DIR=

# Suggestion artefact the gate ingests. Default: artefacts/suggestions_mara.json
AGENTDQ_SUGGESTIONS=
